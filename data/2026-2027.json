  "rounds": [
    {
      "round": 1,
      "date": "Settembre 2026",
      "matches": [
        {
          "id": 1,
          "homeTeam": "Real Pattagghiu",
          "awayTeam": "Real Ichnusa",
          "homeScore": 75.5,
          "awayScore": 70,
          "homeIdealScore": 79,
          "awayIdealScore": 76.5,
          "commentary": {
            "caressa": "Parte col piede giusto il Real Pattagghiu! 2-1 al Real Ichnusa, 75.5 punti contro 70. E il nome sulla copertina è quello di Varela G., 13 punti da solo: un esordio così se lo sognava!",
            "bergomi": "Vittoria meritata, Fabio, ma il Real Ichnusa può recriminare. Pulisic ha fatto la sua parte con 10.5, il problema è dietro: Marcandalli a 4.5 pesa. Curiosità: con le formazioni ideali finirebbe 3-2, stesso verdetto. Andre ha lasciato in panchina solo 4.5 punti, gestione già da veterano."
          }
        },
        {
          "id": 2,
          "homeTeam": "Team24",
          "awayTeam": "Shakhtar Donuts",
          "homeScore": 78.5,
          "awayScore": 70.5,
          "homeIdealScore": 80.5,
          "awayIdealScore": 78.5,
          "commentary": {
            "caressa": "TEAM24 SI PRESENTA COSÌ! 3-1 allo Shakhtar Donuts e 78.5 punti! Moreira, Rabiot e Maldini tutti e tre a quota 10: il centrocampo ha deciso la partita!",
            "bergomi": "Tre giocatori in doppia cifra sono tanta roba, Fabio. Ma guarda la panchina dello Shakhtar: Calò a 10, lasciato fuori. Con le formazioni ideali sarebbe 3-3, e Marco Fedele si mangia le mani: 8 punti buttati via."
          }
        },
        {
          "id": 3,
          "homeTeam": "Ultimo",
          "awayTeam": "Partizan Tirana",
          "homeScore": 69.5,
          "awayScore": 67,
          "homeIdealScore": 74,
          "awayIdealScore": 75,
          "commentary": {
            "caressa": "Non si fanno male Ultimo e Partizan Tirana: 1-1 e tanta fatica! 69.5 a 67. Martinez L. fa il fenomeno con 14 punti, ma dall'altra parte Yeboah J. ne combina di tutti i colori: 1.5!",
            "bergomi": "Partita da dimenticare per entrambe, Fabio. Beppe si salva solo grazie al Toro. E il Partizan? Bernardeschi a 10 rimasto in panchina, roba da non credere. Con le formazioni ideali sarebbe 2-2: qui hanno sbagliato in due."
          }
        },
        {
          "id": 4,
          "homeTeam": "SM Frattese",
          "awayTeam": "Cusiana",
          "homeScore": 78,
          "awayScore": 84,
          "homeIdealScore": 84,
          "awayIdealScore": 90.5,
          "commentary": {
            "caressa": "CHE SPETTACOLO! Cusiana espugna il campo della SM Frattese 4-3, 84 punti a 78! Konè M. a 14, Adzic e Osmajic a 10, Conceicao a 9.5: un attacco devastante!",
            "bergomi": "Il miglior punteggio di giornata, Fabio, e non per caso. Ma attenzione alla SM Frattese: Bremer e Zaccagni a 10, però Jimenez A. a 10 è rimasto fuori. Con le formazioni ideali sarebbe 4-5, quindi Roby e Gaiuz avrebbero vinto comunque. Pezant però lascia per strada 7 punti pieni."
          }
        }
      ],
      "generalComment": "Si riparte, e la prima giornata dice subito che la nuova stagione non sarà per cuori deboli: due volti nuovi al via, Team24 e Real Pattagghiu, ed entrambi portano a casa i tre punti. Cusiana passa in trasferta nell'unica partita con più di cinque gol complessivi, mentre Ultimo e Partizan Tirana si annullano in un match bloccatissimo."
    }
  ],
